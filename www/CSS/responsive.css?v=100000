* {
    box-sizing: border-box;
}

img {
    max-width: 100%;
    height: auto;
}

.container {
    padding-left: 15px;
    padding-right: 15px;
}


h1, h2, h3, h4, h5 {
    font-size: 1.5rem;
}

button, .btn {
    font-size: 1rem;
    padding: 10px;
}

input, select, textarea {
    font-size: 1rem;
}

@media (max-width: 600px) {
    table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }
}
